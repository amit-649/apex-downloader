{
  "name": "apex-merger-service",
  "version": "1.0.0",
  "description": "High-performance native FFmpeg live stream merger microservice for ApexDownloader",
  "main": "server.js",
  "scripts": {
    "postinstall": "node -e \"if (require('fs').existsSync('./install-ytdlp.js')) require('./install-ytdlp.js')\"",
    "start": "node server.js",
    "dev": "node --watch server.js"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@neondatabase/serverless": "^0.10.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fluent-ffmpeg": "^2.1.3",
    "puppeteer-core": "^23.0.0"
  }
}
